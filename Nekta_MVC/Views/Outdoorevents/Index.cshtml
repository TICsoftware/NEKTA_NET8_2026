@{
    ViewData["Title"] = "Company Information";
}

@section Styles {
      <link rel="stylesheet" href="~/Assets/css/center-mode-slider.css">
      <link rel="stylesheet" href="~/Assets/css/blogs-cards-slider.css">
      <link rel="stylesheet" href="Assets/css/thumb-slider.css" />
     
       <link rel="stylesheet" href="Assets/css/outdoorevents.css" />
        <link rel="stylesheet" href="assets/css/page-intro-section.css" /> 
}

      <!-- HERO BANNER END-->
      <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="rounded-bottom-lr overflow-hidden h-170 rounded-bl-xl rounded-br-xl relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="Assets/images/banners/company-info-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="Assets/images/banners/company-info-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="Assets/images/banners/company-info-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-10"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-end">
                  <div class="container pb-12 md:pb-15">
                     <div class="max-w-5xl text-left">

                        <nav class="mb-4" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 Business & Corporates
                              </li>
                           </ol>
                        </nav>

                        <h1 class="innerbanner-title text-h1 text-white">
                           Nekta —
                           <span class="innerbanner-title-span">
                              Business & Corporates
                           </span>
                        </h1>

                     </div>
                  </div>
               </div>
           

         </div>
      </section>
      <!-- HERO BANNER END -->

      <!-- ====================INTRO DOUBLE IMAGE STRUCTURE CSS==================== -->
      <section class=" bc-experience-section relative section-spacing overflow-hidden page-intro-section">

         <div class="container relative z-10">
            <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
               
                  <!-- Left: layered photo composition -->
               <div class="relative">
                  <div class="nourish-media-wrap relative">

      

                     <!-- back photo: chef portrait -->
                     <div class="nourish-photo nourish-photo-back">
                        <img loading="lazy"
                           src="assets/images/outdoorevents/outdoor_intro_behind.webp"
                           alt="Nekta chef in the kitchen">
                     </div>

                     <!-- front photo: plating close-up, overlaps the back photo -->
                     <div class="nourish-photo nourish-photo-front">
                        <img loading="lazy"
                           src="assets/images/outdoorevents/outdoor_intro_front.webp"
                           alt="Chef plating a dish with precision">
                     </div>

                  </div>
               </div>
               <!-- Right: copy -->
               <div class="relative space-y-6 md:space-y-8 sm:max-w-[35vw]">
                  <div class="section-title-outer mx-auto max-w-5xl">
                     <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                       Outdoor Operations. <span class="text-letters-slide">Indoor Standards </span>
                     </h2>
                     
                  </div>
                  <div class="intro-outer-wrapper sm:pl-15">
                  <p>Culinary excellence is at the heart of everything Nekta delivers. From globally inspired cuisines to regional classics, our culinary team brings together innovation, technique and tradition to create food experiences that delight at every scale. As a hospitality-backed catering company drawn from TajSATS catering services and the wider Tata catering company legacy, we treat food as craft, not commodity.</p>

                  </div>

               </div>
            </div>
         </div>
      </section>


<!-- ==================== Outdoor Catering Excellence ==================== -->
<section class="relative bg-[var(--color-primary)] section-spacing overflow-visible">
   <div class="container-fluid mx-auto relative px-0!">

      <div class="relative w-full aspect-[16/6] overflow-hidden oce-dome">
         <div class="curveSvg-bg relative">
   <svg class="curveSvg absolute inset-0 w-full h-full" viewBox="0 0 1000 400" preserveAspectRatio="none" overflow="visible">
      <defs>
         <clipPath id="oceClip" clipPathUnits="userSpaceOnUse">
            <path class="curveClipPath" d="M0,144 A962.8571428571429,962.8571428571429 0 0,1 1000,144 L1000,400 L0,400 Z"></path>
         </clipPath>
      </defs>
      <path class="curvePath" data-max-curve="140" d="M0,144 A962.8571428571429,962.8571428571429 0 0,1 1000,144 L1000,400 L0,400 Z" fill="#e8e0c4"></path>
   </svg>

   <img loading="lazy"
      src="assets/images/outdoorevents/outdoor_catering.png"
      alt="Chef plating outdoor catering desserts"
      class="oce-photo absolute inset-0 w-full h-full object-cover"
      style="clip-path: url(#oceClip);" />
</div>

         <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-6 max-w-2xl mx-auto">
            <h2 class="text-h3 text-[var(--color-cream)]" data-leaf-target letters-slide-down text-split>
               Outdoor <em class="italic font-medium text-[var(--color-secondary)]">Catering Excellence</em>
            </h2>

            <p class="text-[var(--color-cream)]/90 mt-4 max-w-xl">Nekta designs and runs outdoor events with the same discipline followed at our central kitchen, controlling every variable, and utilizing the culinary expertise of TajSATS to elevate the event.</p>

            <p class="text-[var(--color-cream)]/90 mt-4 max-w-xl">Outdoor catering experiences are engineered around the audience, the setting and the moment, blending culinary craftsmanship, banquet-scale logistics and refined service to deliver events that feel effortless and memorable.</p>
         </div>
      </div>

      <!-- Decorative fork + pasta, breaks top-left edge of the dome -->
      <img loading="lazy" src="assets/images/outdoor-catering/fork-pasta.webp" alt=""
         class="hidden md:block absolute -top-8 left-0 w-28 -rotate-6 z-20" aria-hidden="true" />

      <!-- Decorative leaf, top-right, outside the dome -->
      <img loading="lazy" src="assets/images/outdoor-catering/leaf-deco.svg" alt=""
         class="hidden md:block absolute -top-4 right-6 w-10 z-20" aria-hidden="true" />

      <!-- Decorative leaf, small, bottom-left inside the dome -->
      <img loading="lazy" src="assets/images/outdoor-catering/leaf-small.svg" alt=""
         class="hidden md:block absolute bottom-8 left-[16%] w-8 z-20" aria-hidden="true" />

      <!-- Decorative tomato/spice splash, breaks right edge of the dome -->
      <img loading="lazy" src="assets/images/outdoor-catering/tomato-splash.webp" alt=""
         class="hidden md:block absolute top-16 right-0 w-24 z-20" aria-hidden="true" />

   </div>
</section>


  
