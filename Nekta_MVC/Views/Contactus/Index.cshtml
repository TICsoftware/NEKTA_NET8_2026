                     </svg>
                  </a>
               </div>
            </div>
         </section>

         <!-- ==================== EVERY ENQUIRY ==================== -->
         <section class="cu-enquiry-section py-16 md:py-24">
            <img loading="lazy" src="assets/images/contact-us/plate-circle.png" alt=""
               class="cu-plate-deco hidden xl:block w-72 left-[12%] top-[42%] -rotate-6" aria-hidden="true" />
            <img loading="lazy" src="assets/images/contact-us/plate-circle.png" alt=""
               class="cu-plate-deco hidden xl:block w-64 right-[12%] top-[40%] rotate-6" aria-hidden="true" />
            <div class="container relative z-10 text-center">
                  <!-- Section Heading -->
                     <div class="section-title-outer text-center mx-auto max-w-2xl ">
                        <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                     Every enquiry reaches  <span class="text-letters-slide">someone who can act on it.</span>
                        </h2>
                     
                     </div>
               <div class="cu-arch-media mb-5 md:mb-6">
                  <img loading="lazy" src="assets/images/contact-us/arch-team.png"
                     alt="Nekta team reviewing an enquiry" />
               </div>
               <p class="cu-enquiry-copy">
                  We do not believe in generic auto-responses. Every form
                  submission is reviewed by a member of our team and routed
                  to the right specialist within the business. You will hear
                  back from us within
                  <span class="text-green font-balkistItalic italic">two business days.</span>
               </p>
            </div>
         </section>

@section Scripts {
