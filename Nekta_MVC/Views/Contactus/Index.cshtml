@{
    ViewData["Title"] = "About us";
}

@section Styles {
    


     <link rel="stylesheet" href="assets/css/contact-us.css" />
}

         <!-- ==================== HERO BANNER ==================== -->

      <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="rounded-bottom-lr overflow-hidden h-170 rounded-bl-xl rounded-br-xl relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="assets/images/banners/company-info-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="assets/images/banners/company-info-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="assets/images/banners/company-info-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-10"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-end">
                  <div class="container pb-12 md:pb-15">
                     <div class="max-w-4xl text-left">

                        <nav class="mb-4" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 About Us
                              </li>
                           </ol>
                        </nav>

                        <h1 class="innerbanner-title text-h1 text-white">
                          Life is a 
                           <span class="innerbanner-title-span">
                              Beautiful Plate
                           </span>
                        </h1>

                     </div>
                  </div>
               </div>
           

         </div>
      </section>

         <!-- ==================== ENQUIRY FORM ==================== -->
         <section class="cu-form-section section-spacing relative">
         
               <!-- right green image -->
            <img loading="lazy" src="assets/images/contact-us/right_green_leaf.webp" alt=""
              class="cu-leaf-deco cu-leaf-right hidden lg:block" aria-hidden="true" />
              <!-- left green image -->
            <img loading="lazy" src="assets/images/contact-us/left_green_leaf.webp" alt=""
               class="cu-leaf-deco cu-leaf-left hidden lg:block" aria-hidden="true" />


            <div class="container relative z-10">
               <div class="text-center mb-10 md:mb-14">
                  <div class="text-center mb-6 px-6 mx-auto max-w-6xl section-title--light-outer">
                        <h2 class="section-title section-title--light" data-leaf-target letters-slide-down text-split>
                        Tell us a little about your
                           <span
                              class="section-title--dark text-letters-slide"
                              >requirement</span
                              >
                        </h2>
                  <p class="cu-form-intro">
                     Share the basics and a member of our team will get back
                     to you within one business day.
                  </p>
                   </div>


               </div>
               <div class="cu-form-card ">
                  <form class="space-y-6" action="#" method="post">
                     <div class="cu-form-grid">
                        <div class="cu-field">
                           <label for="cuFullName">Full Name <span class="req">*</span></label>
                           <input id="cuFullName" name="fullName" type="text" placeholder="Your full name"
                              autocomplete="name" required />
                        </div>
                        <div class="cu-field">
                           <label for="cuDesignation">Designation</label>
                           <input id="cuDesignation" name="designation" type="text" placeholder="Your role or title"
                              autocomplete="organization-title" />
                        </div>
                        <div class="cu-field">
                           <label for="cuOrganisation">Organisation Name <span class="req">*</span></label>
                           <input id="cuOrganisation" name="organisation" type="text" placeholder="Your organisation"
                              autocomplete="organization" required />
                        </div>
                        <div class="cu-field">
                           <label for="cuEmail">Work Email <span class="req">*</span></label>
                           <input id="cuEmail" name="email" type="email" placeholder="you@company.com"
                              autocomplete="email" required />
                        </div>
                        <div class="cu-field">
                           <label for="cuPhone">Contact Number <span class="req">*</span></label>
                           <input id="cuPhone" name="phone" type="tel" placeholder="+91XXXXXXXXXX"
                              autocomplete="tel" required />
                        </div>
                        <div class="cu-field">
                           <label for="cuCity">City <span class="req">*</span></label>
                           <select id="cuCity" name="city" required>
                              <option value="">Select your city</option>
                              <option value="mumbai">Mumbai</option>
                              <option value="gurugram">Gurugram</option>
                              <option value="bengaluru">Bengaluru</option>
                              <option value="chennai">Chennai</option>
                              <option value="kolkata">Kolkata</option>
                              <option value="goa">MOPA, Goa</option>
                              <option value="other">Other</option>
                           </select>
                        </div>
                        <div class="cu-field cu-field--full">
                           <label for="cuInterest">Area of Interest <span class="req">*</span></label>
                           <select id="cuInterest" name="interest" required>
                              <option value="">Select an area of interest</option>
                              <option value="corporate">Business and Corporate</option>
                              <option value="education">Education</option>
                              <option value="healthcare">Healthcare</option>
                              <option value="events">Outdoor Events</option>
                           </select>
                        </div>
                        <div class="cu-field cu-field--full">
                           <label for="cuMessage">Tell us more.</label>
                           <textarea id="cuMessage" name="message"
                              placeholder="Describe your requirement, scale, or any context that would help us respond meaningfully."></textarea>
                        </div>
                     </div>
                     <label class="cu-consent">
                     <input type="checkbox" name="consent" />
                     <span>I agree to be contacted by Nekta regarding my enquiry.</span>
                     </label>
               
                     <span>
                      <a href="#" class="common-btn btn-slide-fill" type="button" data-modal-open="contactModal">
                      <span>Send enquiry</span>
                      <img loading="lazy" src="assets/images/arrows/creamarrow-long-right.png" alt="rightArrow" />
                      </a>
                     </span>
                     

                  </form>
               </div>
            </div>
         </section>

         <!-- ==================== HOW TO REACH US ==================== -->
         <section class="reach-section section-spacing ">
               
                <!-- Decorative bowl of pistachios (top right) -->
               <img loading="lazy" src="assets/images/contact-us/pista_right.png" alt="" class="deco-bowl" aria-hidden="true" />

               <!-- Decorative plate of pistachios (bottom left) -->
               <img loading="lazy" src="assets/images/contact-us/pista_left.png" alt="" class="deco-plate" aria-hidden="true" />

               <div class="container">

               <!-- Section Heading -->
               <div class="section-title-outer text-center mx-auto max-w-5xl">
                  <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                 How to <span class="text-letters-slide"> Reach Us</span>
                  </h2>
                 
               </div>

                  <div class="reach-grid">

                     <!-- Partnership Enquiries -->
                     <div class="reach-card">
                     <h3>For Partnership Enquiries</h3>
                     <p>If you are looking to partner with Nekta on a food service programme, fill out the form below or write to us directly.</p>

                     <div class="reach-line">
                         <img src="assets/images/contact-us/phone-icon.svg" alt="" class="reach-icon" />
                        <span><h4>Tel No.:</h4> <span class="reach-value">+91 22 3122 0200</span></span>
                     </div>
                     <div class="reach-line">
                         <img src="assets/images/contact-us/mail-icon.svg" alt="" class="reach-icon" />
                        <span><h4>Email id :</h4> <span class="reach-value"><a href="mailto:sales@nektafoods.com">sales@nektafoods.com</a></span></span>
                   
                     </div>

                     <svg class="reach-card-leaf" viewBox="0 0 60 40" aria-hidden="true">
                        <path d="M2 38C10 10 40 2 58 4c-4 18-24 34-56 34z" fill="#8fae6f"/>
                        <path d="M4 36C16 16 38 6 55 5" stroke="#6f8f57" stroke-width="1.4" fill="none"/>
                     </svg>
                     </div>

                     <!-- General Queries -->
                     <div class="reach-card">
                     <h3>For General Queries</h3>
                     <p>For anything else, including media, vendor enquiries or feedback, write to us.</p>

                     <div class="reach-line">
                         <img src="assets/images/contact-us/mail-icon.svg" alt="" class="reach-icon" />
                        <span><h4>Email id :</h4> <span class="reach-value"><a href="mailto:sales@nektafoods.com">sales@nektafoods.com</a></span></span>
                   
                     </div>
                     </div>

                  </div>

                  <!-- ---------- Careers ---------- -->
                  <div class="careers">
               <!-- Section Heading -->
               <div class="section-title-outer text-center mx-auto max-w-5xl">
                  <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                Careers at  <span class="text-letters-slide">NektaOpportunities</span>
                  </h2>
                 
               </div>
                     <p>At Nekta, we're building a team driven by passion, purpose, and a shared commitment to excellence. If you're inspired to shape the future of institutional catering and be part of a dynamic, evolving organisation, we would love to hear from you.</p>
                     <p>Explore current opportunities and take the next step in your journey with us through our careers portal.</p>

                      <a href="#" class="common-btn btn-slide-fill mt-3" type="button" data-modal-open="contactModal">
                      <span>Visit Careers</span>
                      <img loading="lazy" src="assets/images/arrows/creamarrow-long-right.png" alt="rightArrow" />
                      </a>

                     <svg class="careers-leaf-deco" viewBox="0 0 60 40" aria-hidden="true">
                     <path d="M2 38C10 10 40 2 58 4c-4 18-24 34-56 34z" fill="#8fae6f"/>
                     <path d="M4 36C16 16 38 6 55 5" stroke="#6f8f57" stroke-width="1.4" fill="none"/>
                     </svg>
                  </div>

               </div>
         </section>





