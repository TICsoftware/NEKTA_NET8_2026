        <!-- HERO BANNER END-->
      <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="rounded-bottom-lr overflow-hidden h-170 rounded-bl-xl rounded-br-xl relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="assets/images/banners/company-info-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="assets/images/banners/company-info-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="assets/images/banners/company-info-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-10"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-end">
                  <div class="container pb-12 md:pb-15">
                     <div class="max-w-4xl text-left">

                        <nav class="mb-4" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 About Us
                              </li>
                           </ol>
                        </nav>

                        <h1 class="innerbanner-title text-h1 text-white">
                          Life is a 
                           <span class="innerbanner-title-span">
                              Beautiful Plate
                           </span>
                        </h1>

                     </div>
                  </div>
               </div>
           

         </div>
      </section>
   
         <!-- NEXT GENERATION -->
         <section class="nourish-section">
         <div class="container">
         
            <div class="nourish-grid">
         
               <!-- Arch photo -->
               <div class="nourish-media">
               <img loading="lazy" src="assets/images/education/next_generation.png" alt="Friends enjoying a meal together outdoors" class="nourish-img" />
               </div>
         
               <!-- Copy -->
               <div class="nourish-copy">
               
               <!-- Section Heading -->
               <div class="section-title-outer text-left mx-auto max-w-1xl">
                  <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                    Nourishing the  <span class="text-letters-slide"> Next Generation </span>
                  </h2>
                 
               </div>
         
               <p>From campus cafeterias and university and school mess operations to academic events and curated student dining experiences, Nekta brings the rigour of institutional catering backed by the Tata legacy, expertise of Indian Hotel Companies and operational and culinary craft of TajSATS Air Catering Limited to the Indian education segment as a hospitality-backed catering partner.</p>
         
               <p>Our partnerships with leading academic institutions demonstrate our capability to perform within highly stringent nutritional, hygiene, and safety frameworks—delivering carefully curated, balanced, and engaging dining programmes that support learning, development, and overall well-being with uncompromising discipline.</p>
         
               <div class="nourish-btn-row">
                  <a href="#" class="nourish-btn">
                     <span>Get in Touch</span>
                     <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                     <path d="M5 12h14"/>
                     <path d="m12 5 7 7-7 7"/>
                     </svg>
                  </a>
         
                  <img loading="lazy" src="assets/images/contact-us/leaf-icon.webp" alt="" class="nourish-leaf" aria-hidden="true" />
               </div>
               </div>
         
            </div>
         
         </div>
         </section>




