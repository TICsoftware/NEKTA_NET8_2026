}

        <!-- HERO BANNER END-->
      <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="rounded-bottom-lr overflow-hidden h-170 rounded-bl-xl rounded-br-xl relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="assets/images/banners/company-info-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="assets/images/banners/company-info-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="assets/images/banners/company-info-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-10"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-end">
                  <div class="container pb-12 md:pb-15">
                     <div class="max-w-4xl text-left">

                        <nav class="mb-4" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 About Us
                              </li>
                           </ol>
                        </nav>

                        <h1 class="innerbanner-title text-h1 text-white">
                          Life is a 
                           <span class="innerbanner-title-span">
                              Beautiful Plate
                           </span>
                        </h1>

                     </div>
                  </div>
               </div>
           

         </div>
      </section>
  
         <!-- INTRO SECTION -->
         <section class="bg-cream py-16 md:py-20">
            <div class="container mx-auto px-4">
               <div class="max-w-5xl mx-auto text-center intro-section-wrap">
                  <p > A hallmark of catering excellence. Trusted by institutions. Driven by innovation. Nekta Food Solutions Limited is an institutional and corporate catering organization built with purpose and driven by legacy. A wholly owned subsidiary of Taj SATS Air Catering Limited, Nekta is silently extending its craft to serving premium cafés and renowned blue-chip corporates, education and healthcare institutions.
                  </p>
               </div>
            </div>
         </section>
         <!-- INTRO SECTION END -->

          <!-- THREE TILT CARD -->
         <section class="story-gallery bg-cream py-20 overflow-hidden">
            <div class="container mx-auto px-4 relative">
               <!-- Decorations -->
               <img src="assets/images/about-us/tomato.svg"
                  class="absolute left-[11%] bottom-0  pointer-events-none">
               <!-- Leaf -->
               <img
                  src="assets/images/about-us/leaf (2).svg"
                  alt=""
                  class="absolute bottom-10 right-[10%]   z-10">
               <img src="assets/images/about-us/turmuric.svg"
                  class="absolute right-0 bottom-0 pointer-events-none">
               <!-- Cards -->
               <div class="cards-wrapper relative flex justify-center items-center h-[520px]">
                  <!-- Left -->
                  <div class="gallery-card gallery-left">
                     <img src="assets/images/about-us/card-1.png" alt="">
                  </div>
                  <!-- Center -->
                  <div class="gallery-card gallery-center">
                     <img src="assets/images/about-us/card-2.jpg" alt="">
                  </div>
                  <!-- Right -->
                  <div class="gallery-card gallery-right">
                     <img src="assets/images/about-us/card-3.jpg" alt="">
                  </div>
               </div>
            </div>
         </section>
         <!-- THREE CARDS END -->
        
         <!-- COOUNTER SECTION -->
         <section class="counter-section bg-cream py-12 md:py-20">
            <div class="container">
               <div class="counter-wrapper max-w-4xl mx-auto">
                  <!-- Counter -->

                <div class="flex flex-col shrink-0 rounded-2xl px-4 py-6 items-start gap-0 box-itm counter-item">
                    <img src="Assets/images/careers/laboratory-icon.svg" alt="" class="w-auto object-cover"/>
                    <div class="counter-wrap flex items-center gap-2">
