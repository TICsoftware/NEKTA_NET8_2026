        <!-- HERO BANNER END-->
      <section class="relative inside-banner-outer overflow-hidden">
         <div class="inside-banner-inner banner-animation relative ">

            <!-- Banner -->
            <div class="rounded-bottom-lr overflow-hidden h-170 rounded-bl-xl rounded-br-xl relative innerbanner-image-wrapper">

               <!-- Parallax Image -->
               <picture>
                  <!-- Desktop -->
                  <source media="(min-width:1024px)"
                     srcset="assets/images/banners/company-info-banner-desktop.webp">

                  <!-- Tablet -->
                  <source media="(min-width:768px)"
                     srcset="assets/images/banners/company-info-banner-mob.webp">

                  <!-- Mobile -->
                  <img
                     src="assets/images/banners/company-info-banner-mob.webp"
                     alt="About Bubble Food"
                     class="innerbanner-image absolute left-0 top-0 w-full h-full object-cover"
                     loading="eager"
                     fetchpriority="high">
               </picture>

               <!-- Keep Existing Overlay -->
               <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70 z-10"></div>


            </div>

            <!-- Content -->
           
               <div class="innerbanner-caption absolute inset-0 z-30 flex items-end">
                  <div class="container pb-12 md:pb-15">
                     <div class="max-w-4xl text-left">

                        <nav class="mb-4" aria-label="Breadcrumb">
                           <ol class="flex items-center gap-2 text-sm">
                              <li>
                                 <a href="/" class="text-white/70 hover:text-white transition">
                                    Home
                                 </a>
                              </li>

                              <li class="text-white/60">/</li>

                              <li class="text-white">
                                 About Us
                              </li>
                           </ol>
                        </nav>

                        <h1 class="innerbanner-title text-h1 text-white">
                          Nekta - 
                           <span class="innerbanner-title-span">
                              Culinary Excellence
                           </span>
                        </h1>

                     </div>
                  </div>
               </div>
           

         </div>
      </section>
         <!-- ====================Delivering Experiences that Matter ==================== -->
     
         <section class=" bc-experience-section relative section-spacing overflow-hidden page-intro-section">
            <!-- Decorative sushi platter on far right -->
            <img loading="lazy" src="assets/images/business/icon-right.svg" alt=""
               class="bc-deco hidden xl:block w-40 -right-0 top-1/4" aria-hidden="true" />
            <div class="container relative z-10">
               <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                  
                     <!-- Left: layered photo composition -->
                  <div class="relative">
                     <div class="nourish-media-wrap relative">

         

                        <!-- back photo: chef portrait -->
                        <div class="nourish-photo nourish-photo-back">
                           <img loading="lazy"
                              src="assets/images/Culinaryexcellence/chef-portrait.webp"
                              alt="Nekta chef in the kitchen">
                        </div>

                        <!-- front photo: plating close-up, overlaps the back photo -->
                        <div class="nourish-photo nourish-photo-front">
                           <img loading="lazy"
                              src="assets/images/Culinaryexcellence/chef-plating.webp"
                              alt="Chef plating a dish with precision">
                        </div>

                     </div>
                  </div>
                  <!-- Right: copy -->
                  <div class="relative space-y-6 md:space-y-8 sm:max-w-[35vw]">
                     <div class="section-title-outer mx-auto max-w-5xl">
                        <h2 class="title-section text-h2 " data-leaf-target letters-slide-down text-split>
                           Delivering Experiences <span class="text-letters-slide"> that Matter</span>
                        </h2>
                        
                     </div>
                    <div class="intro-outer-wrapper sm:pl-15">
                     <p>From daily cafeteria operations to exclusive boardroom dining, executive offsites and curated events, Nekta understands performance excellence at the highest level. Its relationships with global brands also highlight its compliance with stringent international standards, including security, quality, and employee satisfaction metrics that bring a blend of operational excellence and elevated dining experiences that redefine institutional catering in India.</p>
                     <div class="flex justify-start mt-5">
                           <a href="#" class="common-btn flex items-center gap-2 btn-slide-fill">
                           <span>Get in Touch</span>
                           <img loading="lazy" src="assets/images/arrows/creamarrow-long-right.png" alt="rightArrow" />
                           </a>
                        </div>
                     </div>

                  </div>
               </div>
            </div>
         </section>


                  <!-- ==================== CORPORATE DINING EXCELLENCE ==================== -->
         <section class="bc-dining-section section-pb curveshape-wrap">
               <div class="curveSvg-bg">
                  <svg class="curveSvg" viewBox="0 0 1000 400" preserveAspectRatio="none" overflow="visible">
                     <path class="curvePath" data-max-curve="140"
                           d="M0,144 L1000,144 L1000,400 L0,400 Z" fill="#e8e0c4"></path>
                  </svg>
               </div>
               <!-- Tilted polaroids -->
               <div class="outer-polaroids-icons">
                  <div class="outer-polaroids">
                     <img loading="lazy" src="assets/images/Culinaryexcellence/capscum.webp" alt="" class="bc-deco bc-dining-deco--chili" aria-hidden="true" />
                     <div class="bc-polaroid bc-polaroid--left">
                     
                        <img loading="lazy" src="assets/images/business/polaroid-left.jpg" alt="Corporate lunch meeting" />
                     </div>
                  </div>
                  <div class="bc-polaroid bc-polaroid--right">
                     <img loading="lazy" src="assets/images/business/polaroid-right.jpg" alt="Team dining together" />
                  </div>
            
                  
                  <img loading="lazy" src="assets/images/business/icon-1.webp" alt="" class="bc-deco bc-dining-deco--basil" aria-hidden="true" />
               </div>


               <div class="container relative z-10">
                  <!-- Section Heading -->
                        <div class="section-title-outer text-center max-w-6xl mx-auto">
                           <h2 class="title-section text text-h2" data-leaf-target letters-slide-down text-split>Corporate Dining <span class="text-letters-slide">Excellence</span>
                           </h2>
                           
                        </div>

                  <div class="max-w-3xl mx-auto text-center">
                        <p>
                           Corporate dining is where Nekta sets the standard. We
                           operate at scale with precision&mdash;delivering
                           consistent quality, reliability, safety and service
                           excellence across geographies, even in the most
                           demanding environments.
                        </p>
                        <p>
                           But our proposition goes beyond food. At Nekta, we
                           curate integrated dining experiences that enhance the
                           workplace&mdash;where every meal is thoughtfully
                           designed to delight consumers, elevate satisfaction,
                           and reflect the premium standards of modern
                           institutional catering.
                        </p>
                        <p>
                           With a deep understanding of high-volume operations
                           and evolving expectations, we partner with leading
                           organisations to design, manage, and continuously
                           refine dining programmes that consistently deliver on
                           quality, experience, and trust.
                        </p>
                  </div>
               </div>
         </section>


         <!-- THREE TILT CARD -->

         <section class="story-gallery section-spacing">
            <div class="container">

                           <!-- Section Heading -->
               <div class="section-title-outer text-center mx-auto max-w-5xl section-spacing">
