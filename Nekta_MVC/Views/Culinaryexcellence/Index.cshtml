         <!-- COOUNTER SECTION -->
         <section class="counter-section section-pb">
            <div class="container">
               <div class="counter-wrapper sm:max-w-4xl sm:mx-auto">
                  <!-- Counter -->

                <div class="flex flex-col shrink-0 rounded-2xl px-4 py-6 items-start gap-0 box-itm counter-item">
                    <img src="Assets/images/careers/laboratory-icon.svg" alt="" class="w-auto object-cover"/>
                    <div class="counter-wrap flex items-center gap-2">
                        <div class="counter" data-target="200" data-suffix="K">0</div>
                    </div>
                    <p>Meals Served Daily</p>
                </div>


                  <!-- Divider -->
                  <div class="counter-divider"></div>
                  <!-- Counter -->
                   <div class="flex flex-col shrink-0 rounded-2xl px-4 py-6 items-start gap-0 box-itm counter-item">
                        <img src="Assets/images/careers/laboratory-icon.svg" alt="" class="w-auto object-cover"/>
                        <div class="counter-wrap flex items-center gap-2">
                            <div class="counter" data-target="09">0</div>
                        </div>
                        <p>Locations</p>
                    </div>

                 
                  <!-- Divider -->
                  <div class="counter-divider"></div>
                  <!-- Counter -->
                  <div class="flex flex-col shrink-0 rounded-2xl px-4 py-6 items-start gap-0 box-itm counter-item">
                        <img src="Assets/images/careers/laboratory-icon.svg" alt="" class="w-auto object-cover"/>
                        <div class="counter-wrap flex items-center gap-2">
                            <div class="counter" data-target="3000" data-suffix="+">0</div>
                        </div>
                        <p>Chefs</p>
                    </div>
                 
               </div>
            </div>
         </section>
